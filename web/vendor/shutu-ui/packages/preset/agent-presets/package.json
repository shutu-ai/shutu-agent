{
  "name": "@shutu-ai/agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the DeepSeek Harness",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shutu-ai/shutu-agent.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shutu-ai/cordis-plugin-include": "workspace:^",
    "@shutu-ai/cordis-plugin-loader": "workspace:^",
    "@shutu-ai/agent": "workspace:^",
    "@shutu-ai/atomic-write": "workspace:^",
    "@shutu-ai/invariants": "workspace:^",
    "@shutu-ai/home-paths": "workspace:^",
    "@shutu-ai/scope": "workspace:^",
    "@shutu-ai/session": "workspace:^",
    "@shutu-ai/settings": "workspace:^",
    "@shutu-ai/system-prompt": "workspace:^",
    "@shutu-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@shutu-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@shutu-ai/cordis-plugin-include": "workspace:^",
    "@shutu-ai/cordis-plugin-loader": "workspace:^",
    "@shutu-ai/agent": "workspace:^",
    "@shutu-ai/agent-loop": "workspace:^",
    "@shutu-ai/atomic-write": "workspace:^",
    "@shutu-ai/invariants": "workspace:^",
    "@shutu-ai/llm": "workspace:^",
    "@shutu-ai/home-paths": "workspace:^",
    "@shutu-ai/scope": "workspace:^",
    "@shutu-ai/session": "workspace:^",
    "@shutu-ai/settings": "workspace:^",
    "@shutu-ai/settings-file": "workspace:^",
    "@shutu-ai/system-prompt": "workspace:^",
    "@shutu-ai/tools": "workspace:^",
    "@shutu-ai/cordis": "workspace:^"
  }
}
