{
  "name": "@shutu-ai/tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shutu-ai/shutu-agent.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shutu-ai/agent": "workspace:^",
    "@shutu-ai/invariants": "workspace:^",
    "@shutu-ai/llm": "workspace:^",
    "@shutu-ai/session": "workspace:^",
    "@shutu-ai/system-prompt": "workspace:^",
    "@shutu-ai/tools": "workspace:^",
    "@shutu-ai/workflow": "workspace:^",
    "@shutu-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@shutu-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@shutu-ai/agent": "workspace:^",
    "@shutu-ai/invariants": "workspace:^",
    "@shutu-ai/llm": "workspace:^",
    "@shutu-ai/session": "workspace:^",
    "@shutu-ai/subagent": "workspace:^",
    "@shutu-ai/system-prompt": "workspace:^",
    "@shutu-ai/tools": "workspace:^",
    "@shutu-ai/workflow": "workspace:^",
    "@shutu-ai/workflow-worker-thread": "workspace:^",
    "@shutu-ai/cordis": "workspace:^"
  }
}
