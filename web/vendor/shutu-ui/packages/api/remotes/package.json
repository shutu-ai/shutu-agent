{
  "name": "@shutu-ai/api-remotes",
  "description": "Remote BFF assembly and Host Agent/Session lookup policy",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shutu-ai/shutu-agent.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "shutu": {
    "client": {
      "inject": [
        "@shutu-ai/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@shutu-ai/typert-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@shutu-ai/agent": "workspace:^",
    "@shutu-ai/agent-presets": "workspace:^",
    "@shutu-ai/api-gateway": "workspace:^",
    "@shutu-ai/commands": "workspace:^",
    "@shutu-ai/cordis-host-runner": "workspace:^",
    "@shutu-ai/credentials": "workspace:^",
    "@shutu-ai/file-reference": "workspace:^",
    "@shutu-ai/goal": "workspace:^",
    "@shutu-ai/host-plugin-inventory": "workspace:^",
    "@shutu-ai/invariants": "workspace:^",
    "@shutu-ai/llm": "workspace:^",
    "@shutu-ai/message-feedback": "workspace:^",
    "@shutu-ai/session": "workspace:^",
    "@shutu-ai/session-persistence": "workspace:^",
    "@shutu-ai/session-reference": "workspace:^",
    "@shutu-ai/settings": "workspace:^",
    "@shutu-ai/typert-registry": "workspace:^",
    "@shutu-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@shutu-ai/agent": "workspace:^",
    "@shutu-ai/agent-presets": "workspace:^",
    "@shutu-ai/api-gateway": "workspace:^",
    "@shutu-ai/commands": "workspace:^",
    "@shutu-ai/cordis-host-runner": "workspace:^",
    "@shutu-ai/credentials": "workspace:^",
    "@shutu-ai/file-reference": "workspace:^",
    "@shutu-ai/goal": "workspace:^",
    "@shutu-ai/host-plugin-inventory": "workspace:^",
    "@shutu-ai/invariants": "workspace:^",
    "@shutu-ai/llm": "workspace:^",
    "@shutu-ai/message-feedback": "workspace:^",
    "@shutu-ai/session": "workspace:^",
    "@shutu-ai/session-persistence": "workspace:^",
    "@shutu-ai/session-reference": "workspace:^",
    "@shutu-ai/settings": "workspace:^",
    "@shutu-ai/typert-registry": "workspace:^",
    "@shutu-ai/cordis": "workspace:^"
  }
}
